# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=          # Required. Your OpenRouter API key.
ANALYZER_MODEL=              # Optional. Default: anthropic/claude-sonnet-5
SYNTHESIS_MODEL=             # Optional. Default: anthropic/claude-sonnet-5

# --- Web search (Tavily) ---
WEB_SEARCH_API_KEY=          # Optional. Without it, Tavily runs in keyless/rate-limited mode.

# --- Data locations ---
CONFIG_DIR=                  # Optional. Default: <repo_root>/configs/connectors
VAULT_DIR=                   # Optional. Default: <repo_root>/fixtures/data/vault
CORPUS_DIR=                  # Optional. Default: <repo_root>/fixtures/data/corpus
CHROMA_PERSIST_DIR=          # Optional. Default: .chroma (relative to cwd)

# --- Query defaults ---
DEFAULT_TOP_K=               # Optional. Default: 5
MAX_FUSED_ITEMS=             # Optional. Default: 10